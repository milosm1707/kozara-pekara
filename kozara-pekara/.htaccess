# ============================================
# Pekara — Apache .htaccess
# Hostinger kompatibilno
# ============================================

Options -Indexes

# PHP version (Hostinger)
# AddType application/x-httpd-php81 .php

# ============================================
# URL rewrite (opcionalno - za pretty URLs)
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Preusmjeri na HTTPS (uključiti na produkciji)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ============================================
# Sigurnost
# ============================================

# Zaštiti includes folder od direktnog pristupa
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
</IfModule>

# Zabrani pristup fajlovima s osjetljivim ekstenzijama
<FilesMatch "\.(sql|log|env|ini|bak|sh)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Sakrij X-Powered-By header
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================
# Cache za statičke fajlove
# ============================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg    "access plus 1 month"
    ExpiresByType image/jpeg   "access plus 1 month"
    ExpiresByType image/png    "access plus 1 month"
    ExpiresByType image/gif    "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp   "access plus 1 month"
    ExpiresByType text/css     "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ============================================
# Kompresija
# ============================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>

# ============================================
# Greške
# ============================================
ErrorDocument 403 /index.php
ErrorDocument 404 /index.php

# ============================================
# Zaštita uploads foldera (PHP fajlovi)
# ============================================
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
